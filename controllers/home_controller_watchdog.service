[Unit]
Description=Home Controller Display Liveness Watchdog
After=home_controller.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/controllers/home_controller_watchdog.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
