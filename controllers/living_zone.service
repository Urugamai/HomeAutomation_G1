[Unit]
Description=Raspberry Pi Living Area I2C Sensor & Waveshare HVAC Relay Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/controllers/environment_daemon.py
Restart=always
RestartSec=5
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
