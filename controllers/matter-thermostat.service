[Unit]
Description=Meross Matter Thermostat MQTT Bridge
Wants=network-online.target matter-server.service
After=network-online.target matter-server.service

[Service]
Type=simple
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/controllers/matter_thermostat_daemon.py
Restart=always
RestartSec=10
User=markw
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
