[Unit]
Description=Raspberry Pi C-Bus Integrated Automatic Shutter Controller Daemon
After=network.target homeautomation-update.service
Wants=homeautomation-update.service

[Service]
Type=simple
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/controllers/blind_daemon.py
Restart=always
RestartSec=10
User=markw
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
