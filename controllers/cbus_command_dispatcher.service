[Unit]
Description=Serialized C-Bus Command Dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/controllers/cbus_command_dispatcher.py
Restart=always
RestartSec=5
User=markw
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
