[Unit]
Description=Home Automation Controller Display
Wants=network-online.target homeautomation-update.service
After=network-online.target homeautomation-update.service graphical.target display-manager.service

[Service]
Type=simple
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
Environment=QT_AUTO_SCREEN_SCALE_FACTOR=1
Environment=QT_QPA_PLATFORM=xcb
Environment=GTK_USE_PORTAL=0
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/markw/.Xauthority
EnvironmentFile=-/etc/default/home_controller
ExecStart=/bin/bash /home/markw/HomeAutomation_G1/autostart.sh
Restart=always
RestartSec=10
User=markw
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
