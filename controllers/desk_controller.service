[Unit]
Description=Home Automation Desktop Controller Display
Wants=network-online.target homeautomation-update.service
After=network-online.target homeautomation-update.service graphical.target display-manager.service

[Service]
Type=simple
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
Environment=QT_AUTO_SCREEN_SCALE_FACTOR=1
Environment=QT_QPA_PLATFORM=xcb
Environment=GTK_USE_PORTAL=0
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/markw/.Xauthority
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/desk_controller.py
Restart=always
RestartSec=10
User=markw
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
