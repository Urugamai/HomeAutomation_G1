[Unit]
Description=Raspberry Pi Smart Home HVAC Core Engine & Relay Supervisor
After=network.target homeautomation-update.service
Wants=homeautomation-update.service

[Service]
Type=simple
# Adjust this file path to match exactly where your script is stored on the Pi
WorkingDirectory=/home/markw/HomeAutomation_G1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/markw/HomeAutomation_G1/controllers/hvac_daemon.py
Restart=always
RestartSec=5
User=markw
# Redirect stdout/stderr directly into your system logging engine
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
